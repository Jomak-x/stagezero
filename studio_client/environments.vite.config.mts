import {defineConfig} from 'vite';
import {resolve} from 'node:path';
import {mkdir,writeFile} from 'node:fs/promises';
const output=resolve('../review/demo-environments/captures');
export default defineConfig({cacheDir:resolve('../.runtime/environment-vite-cache'),publicDir:false,plugins:[{name:'environment-local-evidence',configureServer(server){server.middlewares.use(async(req,res,next)=>{if(!req.url?.startsWith('/__environment/'))return next();if(req.method!=='POST'||req.headers.origin!=='http://127.0.0.1:24974'){res.statusCode=403;res.end();return;}let size=0;const chunks:Buffer[]=[];try{for await(const chunk of req){size+=chunk.length;if(size>128*1024*1024)throw new Error('Evidence too large');chunks.push(Buffer.from(chunk));}await mkdir(output,{recursive:true});const route=new URL(req.url,'http://127.0.0.1:24974');const name=(route.searchParams.get('name')||'environment').replace(/[^a-zA-Z0-9_-]/g,'').slice(0,80)+'-'+Date.now();const raw=Buffer.concat(chunks);if(route.pathname==='/__environment/still'){const data=JSON.parse(raw.toString());if(!/^data:image\/png;base64,/.test(data.image))throw new Error('Expected PNG');await writeFile(resolve(output,name+'.png'),Buffer.from(data.image.split(',')[1],'base64'));delete data.image;await writeFile(resolve(output,name+'.json'),JSON.stringify(data,null,2));}else if(route.pathname==='/__environment/video'){await writeFile(resolve(output,name+'.webm'),raw);}else throw new Error('Unknown route');res.setHeader('Content-Type','application/json');res.end(JSON.stringify({saved:name}));}catch(e){res.statusCode=400;res.end(String(e));}});}}],server:{host:'127.0.0.1',port:24974,strictPort:true},build:{outDir:'../.runtime/environment-client-build',rollupOptions:{input:resolve('environments.html')}}});
