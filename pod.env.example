# Copy to .runtime/pod.env; keep real connection details out of Git.
STAGEZERO_SSH_HOST=root@YOUR_POD_IP
STAGEZERO_SSH_PORT=YOUR_POD_SSH_PORT
STAGEZERO_SSH_KEY="$HOME/.ssh/id_ed25519"
STAGEZERO_VIEWER_URL=http://YOUR-MINI.YOUR-TAILNET.ts.net:2334/

# Optional: existing authenticated native-pair worker for Motion → AI cast.
# This file contains connection settings only; it does not rent or start a Pod.
# STAGEZERO_NATIVE_PAIR_CONFIG="$PWD/.runtime/prompt-native-provider.json"
